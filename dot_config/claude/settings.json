{
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-fable-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-opus-5[1m]"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "plan"
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "wt list statusline --format=claude-code"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "Japanese",
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "editorMode": "normal",
  "inputNeededNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(mise install)",
      "Bash(mise run:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(gcloud secrets:*)",
      "Bash(gsutil rm:*)"
    ]
  }
}
